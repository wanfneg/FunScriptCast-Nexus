# 界面测试产物（截图与审计数据，可随时重新生成）
/tests/_shots/
/tests/_audit.json
/tests/_geo.json

# 安装包产物
test-fresh-install/
models/_download/

# ASR 运行时（audio.cpp CPU 版，fetch_audiocpp.ps1 拉取/构建内置）
vendor/audiocpp/
nul
build/.cache/release-carry/
build/.cache/audiocpp-stage/llama-runtime-windows.zip
build/.cache/qq-promo/*.zip
build/_audiocpp-cuda-stage/

# 内部产物（构建暂存区 / 评测样本与结果 / 运行日志 / 配置备份，不入库）
build/.cache/audiocpp-stage/
tests/_eval_*
tests/_combo_judge_*
vendor/subtitle/docs/*.txt
vendor/subtitle/config.json.bak-*

# libmpv 运行库（121MB，fetch_mpv.ps1 拉取；构建机与开发机就地放置）
vendor/mpv/libmpv-2.dll
# player 目录里的同名副本（外挂播放器弃用后已删；曾漏忽略被误提交 121MB）
vendor/player/libmpv-2.dll
build/_thumb-probe/
build/.cache/mpv-proto/
@AutomationLog.txt

