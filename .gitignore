# Python
__pycache__/
*.pyc

# 大体积本地资产（模型 8GB / venv 5GB，不入库）
.venv/
.venv-vibevoice/
models/
models/hf/
models/vibevoice/
# llama.cpp 运行时（llama-server.exe + CUDA 运行时约 1.1 GB）——
# 由 tools\fetch_llama.ps1 下载复现，不入库
vendor/llama/

# 运行数据
*.log
*.tmp
_runtime/
# 用户数据目录（R49 起数据都落安装目录，源码模式就是仓库根）：配置 / 术语表 /
# 宿主设置 / DLNA 数据。见 vendor/subtitle/user_paths.py。
/data/
# 日志（宿主 host.log + 字幕服务 run_server.log 同处一处）
/logs/
# 运行时临时文件（子进程配置、VAD 转储、设备同步临时包、WebView2 profile）
# 注意 data/webview 在 /data/ 之下，已被上面那条覆盖。
/run/

# 字幕缓存（运行时生成，不入库）
/cache/

# 术语表旧版备份（换表时留档，不入库）
/backup/

# 字幕测试产物
/tests/subtitle_out/
/tests/_*_log.txt

# 构建产物
/dist/
/dist-app/
/build/work/
/build/__pycache__/

# 编辑器
.vscode/
.idea/

# Lucide 图标下载缓存（生成结果已经内联进 ui/index.html，缓存本身不入库）
/tools/.lucide-cache/

# 界面测试产物（截图与审计数据，可随时重新生成）
/tests/_shots/
/tests/_audit.json
/tests/_geo.json

# 安装包产物
/dist-installer/
