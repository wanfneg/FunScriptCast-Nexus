# llama.cpp 运行时（llama-server.exe + CUDA 运行时约 1.1 GB）——
# 由 tools\fetch_llama.ps1 下载复现，不入库
vendor/llama/

# 运行数据
*.log
*.tmp
_runtime/
# 运行数据（安装目录约定：data/logs/run/backup 都在 var/ 下）：
# 配置 / 术语表 / 宿主设置 / DLNA 数据 / 日志 / 临时文件 / 换表备份。
# 见 vendor/subtitle/user_paths.py。
/var/

# 字幕缓存（运行时生成，不入库）
/cache/

# 字幕测试产物
/tests/subtitle_out/
/tests/_*_log.txt

# 构建产物
/dist/
/artifacts/
/build/.cache/
/build/work/
/build/__pycache__/

# 编辑器
.vscode/
.idea/

# Lucide 图标下载缓存（生成结果已经内联进 ui-legacy/index.html，缓存本身不入库）
