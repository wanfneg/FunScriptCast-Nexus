# Python
__pycache__/
*.pyc

# 大体积本地资产（模型 8GB / venv 5GB，不入库）
.venv/
.venv-vibevoice/
models/
models/hf/
models/vibevoice/

# 运行数据
*.log
*.tmp
_runtime/

# 字幕缓存（运行时生成，不入库）
/cache/

# 术语表旧版备份（换表时留档，不入库）
/backup/

# 字幕测试产物
/tests/subtitle_out/
/tests/_*_log.txt

# 构建产物
/dist/
/dist-app/
/build/work/
/build/__pycache__/

# 编辑器
.vscode/
.idea/

# Lucide 图标下载缓存（生成结果已经内联进 ui/index.html，缓存本身不入库）
/tools/.lucide-cache/

# 界面测试产物（截图与审计数据，可随时重新生成）
/tests/_shots/
/tests/_audit.json
/tests/_geo.json
