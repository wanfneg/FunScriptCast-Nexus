{
  "asr": {
    "model": "../../models/Qwen3-ASR-0.6B",
    "aligner": "../../models/Qwen3-ForcedAligner-0.6B",
    "device": "cuda:0",
    "dtype": "bf16",
    "quantization": "none",
    "bnb_quant_type": "nf4",
    "bnb_double_quant": true,
    "use_glossary_context": true,
    "context_max_chars": 0,
    "max_new_tokens_per_sec": 4.0,
    "max_new_tokens_min": 48,
    "max_new_tokens_max": 256,
    "backend": "audiocpp",
    "audiocpp": {
      "dir": "E:/audiocpp-portable",
      "backend": "cuda",
      "threads": 1,
      "port": 8081,
      "language": "Japanese",
      "min_speech_ms": 250,
      "merge_gap_sec": 0.5,
      "pad_sec": 0.25
    }
  },
  "vad": {
    "enabled": true,
    "threshold": 0.5
  },
  "segment": {
    "max_sec": 8.0,
    "max_chars": 50,
    "pause_sec": 0.8,
    "min_sec": 1.2,
    "min_chars": 4
  },
  "translate": {
    "backend": "ollama",
    "ollama": {
      "base_url": "http://127.0.0.1:11434",
      "model": "zincles/sakura-1.5b-qwen2.5-v1.0-q5ks"
    },
    "openai": {
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "api_key_env": "DASHSCOPE_API_KEY",
      "model": "qwen-mt-turbo",
      "target_lang": "Chinese"
    },
    "batch_size": 10,
    "max_steps": 3,
    "thread_num": 4,
    "cache": false,
    "target_lang": "zh",
    "fallback": {
      "enabled": true,
      "backend": "auto",
      "after_fail_batches": 3
    },
    "mt_system": "你是一个轻小说翻译模型，可以流畅通顺地以日本轻小说的风格将日文翻译成简体中文，并联系上下文正确使用人称代词，不擅自添加原文中没有的代词。",
    "mt_user_prefix": "将下面的日文文本翻译成中文："
  },
  "glossary": {
    "ja": "glossary_ja_zh.json",
    "en": "glossary_en_zh.json",
    "extra": {
      "ja": {
        "悠亜": "悠亚",
        "三上悠亜": "三上悠亚",
        "御神悠亜": "御神悠亚",
        "悠亜様": "悠亚大人",
        "ゆあ": "悠亚"
      }
    }
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8756,
    "idle_release_min": 15
  }
}